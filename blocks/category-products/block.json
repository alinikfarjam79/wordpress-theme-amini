{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "my-theme/category-products",
  "version": "1.2.5",
  "title": "محصولات بر اساس دسته‌بندی",
  "category": "theme",
  "icon": "products",
  "description": "نمایش داینامیک محصولات ووکامرس در تب دسته‌بندی و اسلایدر",
  "textdomain": "my-theme",
  "attributes": {
    "title": {"type":"string","default":"محصولات براساس دسته‌بندی"},
    "categoryIds": {"type":"array","items":{"type":"number"},"default":[]},
    "productsCount": {"type":"number","default":12},
    "buttonText": {"type":"string","default":"مشاهده همه"},
    "buttonUrl": {"type":"string","default":""},
    "showNavigation": {"type":"boolean","default":true},
    "showPagination": {"type":"boolean","default":true},
    "headingColor": {"type":"string","default":"#1a1e1b"},
    "headingSize": {"type":"number","default":32},
    "tabColor": {"type":"string","default":"#111111"},
    "activeTabColor": {"type":"string","default":"#111111"},
    "activeTabBorderColor": {"type":"string","default":"#16a34a"},
    "tabSize": {"type":"number","default":15},
    "cardBackground": {"type":"string","default":"#ffffff"},
    "cardBorderColor": {"type":"string","default":"#d9d9d9"},
    "cardBorderWidth": {"type":"number","default":0},
    "cardRadius": {"type":"number","default":8},
    "cardPadding": {"type":"number","default":0},
    "mobileCardPadding": {"type":"number","default":0},
    "mobileCardWidth": {"type":"number","default":200},
    "mobileCardHeight": {"type":"number","default":268},
    "mobileCardRadius": {"type":"number","default":8},
    "mobileCardShadow": {"type":"boolean","default":true},
    "cardWidth": {"type":"number","default":200},
    "cardHeight": {"type":"number","default":270},
    "cardShadow": {"type":"boolean","default":false},
    "imageHeight": {"type":"number","default":96},
    "mobileImageHeight": {"type":"number","default":150},
    "mobileImageContainerHeight": {"type":"number","default":200},
    "mobileCardBorderWidth": {"type":"number","default":1},
    "productTitleColor": {"type":"string","default":"#1a1e1b"},
    "productTitleSize": {"type":"number","default":16},
    "mobileProductTitleSize": {"type":"number","default":16},
    "mobileHeadingSize": {"type":"number","default":22},
    "mobileTabSize": {"type":"number","default":14},
    "arrowBackground": {"type":"string","default":"#16a34a"},
    "arrowColor": {"type":"string","default":"#ffffff"},
    "arrowSize": {"type":"number","default":48},
    "bulletColor": {"type":"string","default":"#ffffff"},
    "bulletActiveColor": {"type":"string","default":"#d2d2d2"},
    "buttonBackground": {"type":"string","default":"#16a34a"},
    "buttonColor": {"type":"string","default":"#ffffff"},
    "buttonRadius": {"type":"number","default":56},
    "desktopGap": {"type":"number","default":40},
    "tabletGap": {"type":"number","default":32},
    "mobileGap": {"type":"number","default":10}
  },
  "supports": {"align":["wide","full"],"anchor":true,"className":true,"html":false,"multiple":true,"spacing":{"margin":true,"padding":true}},
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}
