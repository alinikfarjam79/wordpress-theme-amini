{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "theme/product-category-brand-filter",
  "version": "1.0.0",
  "title": "Product Category Brand Filter",
  "category": "woocommerce",
  "icon": "tag",
  "textdomain": "my-theme",
  "parent": ["theme/product-category-filter-card"],
  "attributes": {
    "label": {
      "type": "string",
      "default": "برند"
    },
    "placeholder": {
      "type": "string",
      "default": "جستجو برند"
    }
  },
  "supports": {
    "align": false,
    "anchor": true,
    "className": true,
    "html": false,
    "spacing": {
      "margin": true,
      "padding": true
    },
    "color": {
      "background": true,
      "text": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php",
  "style": "my-theme-product-archive"
}
