{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "theme/product-breadcrumb",
  "version": "1.0.0",
  "title": "Product Breadcrumb",
  "category": "woocommerce",
  "icon": "products",
  "textdomain": "my-theme",
  "attributes": {
    "fontSize": {
      "type": "string"
    },
    "fontWeight": {
      "type": "string",
      "default": "400"
    },
    "inactiveColor": {
      "type": "string",
      "default": "rgba(103, 111, 113, 1)"
    },
    "activeColor": {
      "type": "string",
      "default": "rgba(26, 30, 27, 1)"
    },
    "separator": {
      "type": "string",
      "default": "/"
    },
    "homeLabel": {"type":"string","default":"خانه"},
    "showHome": {"type":"boolean","default":true},
    "showCurrent": {"type":"boolean","default":true},
    "backgroundColor": {"type":"string","default":"transparent"},
    "borderColor": {"type":"string","default":"transparent"},
    "borderWidth": {"type":"number","default":0},
    "borderRadius": {"type":"number","default":0},
    "marginTop": {"type":"number","default":0},
    "marginBottom": {"type":"number","default":32},
    "paddingTop": {"type":"number","default":0},
    "paddingBottom": {"type":"number","default":0},
    "paddingInline": {"type":"number","default":0},
    "separatorGap": {"type":"number","default":8}
  },
  "usesContext": ["postId", "postType", "theme/productId"],
  "supports": {
    "align": false,
    "anchor": false,
    "customClassName": true,
    "html": false
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
