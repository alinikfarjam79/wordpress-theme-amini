{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "my-theme/header-pages-menu",
  "version": "1.1.0",
  "title": "منوی صفحات هدر",
  "category": "theme",
  "icon": "menu",
  "description": "نمایش خودکار صفحات منتشرشده در منوی اصلی هدر",
  "textdomain": "my-theme",
  "attributes": {
    "autoCount": {
      "type": "number",
      "default": 6
    },
    "manualMode": {
      "type": "boolean",
      "default": false
    },
    "items": {
      "type": "array",
      "default": []
    }
  },
  "supports": {
    "align": false,
    "anchor": false,
    "className": false,
    "html": false,
    "reusable": false
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
